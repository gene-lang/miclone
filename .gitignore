# Reference checkout of upstream Luanti, cloned by hand:
#
#   git clone --depth 1 https://github.com/luanti-org/luanti luanti
#
# It is read-only source material for this design (see docs/design.md,
# Appendix A) and is deliberately not vendored into this repository.
/luanti/

# Generated by `tools/build_web.sh` — never edited by hand.
/dist/

# Gene's build cache and Python bytecode from the launcher.
.gene/
__pycache__/
